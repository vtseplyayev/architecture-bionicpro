        <!-- ===== Существующие контейнеры ===== -->
        <mxCell id="chip" value="&lt;b&gt;Программа в чипе протеза&lt;/b&gt;&lt;div&gt;[Container: ESP32, C++]&lt;/div&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Распознаёт миосигналы (&amp;lt;100 мс), шлёт телеметрию по 4G&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mobile" value="&lt;b&gt;Мобильное приложение&lt;/b&gt;&lt;div&gt;[Container: Android / iOS]&lt;/div&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Донастройка протеза, скачивание отчёта&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="295" y="210" width="215" height="120" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;Reports SPA&lt;/b&gt; &lt;i&gt;(изменён)&lt;/i&gt;&lt;div&gt;[Container: React 18, TS, keycloak-js]&lt;/div&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Authorization Code + &lt;b&gt;PKCE S256&lt;/b&gt;; токенов IdP не хранит&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="210" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- ===== Новое: BFF и хранилище сессий ===== -->
        <mxCell id="bff" value="&lt;b&gt;BFF / Auth Gateway&lt;/b&gt; &lt;i&gt;(новый)&lt;/i&gt;&lt;div&gt;[Container: Node.js / Spring, confidential client]&lt;/div&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Обмен code→токены, хранит токены на сервере, отдаёт браузеру только httpOnly-cookie&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
